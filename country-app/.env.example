# Configuración de la API REST Countries (https://restcountries.com)
# Las variables deben empezar con VITE_ para ser accesibles desde el cliente (Vite).

# URL base de la API.
#   - Versión legacy pública (sin api key, redirige a legacy.json): https://restcountries.com/v3.1
#   - Nueva API oficial (requiere api key):                        https://api.restcountries.com/v3.1
VITE_API_URL=https://api.restcountries.com/v3.1

# API KEY: léela aquí y cámbiala por tu clave real.
# Para la API pública legacy puedes dejarla vacía.
# Para https://api.restcountries.com se envía en la cabecera "x-rapidapi-key".
VITE_API_KEY=tu_api_key_aqui
