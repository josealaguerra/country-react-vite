# Configuración del backend para la API REST Countries.
# Este archivo solo se carga en el backend; la clave no se entrega al navegador.

# Base URL de la API actual. Las rutas de países se agregan automáticamente.
REST_COUNTRIES_API_URL=https://api.restcountries.com/countries/v5

# Sustituye el valor de ejemplo por una clave válida de REST Countries.
# Se envía únicamente desde el backend en la cabecera Authorization.
REST_COUNTRIES_API_KEY=tu_api_key_aqui
