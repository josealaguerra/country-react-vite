    "@vitejs/plugin-react": "^5",
    "autoprefixer": "^10.4.20",
    "dompurify": "^3.4.17",
    "eslint": "^9.39.5",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.2.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^7",
    "vitest": "^4",
